# Copy to .env for local Docker Compose; server-side secrets only.
GEMINI_API_KEY=replace_with_server_secret
GOOGLE_API_KEY=replace_with_server_secret
GEMINI_MODEL=gemini-3.8-flash
GEMINI_REQUEST_TIMEOUT_SECONDS=45
GEMINI_MAX_ATTEMPTS=2
GEMINI_MAX_CONCURRENCY=3
GEMINI_QUEUE_TIMEOUT_SECONDS=10
CONTENT_MAX_BATCH_CHARS=24000
CONTENT_MAX_BATCH_PAGES=4
EXTRACTION_RETAIN_REVIEW_CANDIDATES=false
FAULT_INJECTION_ENABLED=false
AUTOPSY_FAKE_GEMINI=false
AUTOPSY_FAKE_GEMINI_RESULTS=/app/insurance-pipeline/demo_documents/gemini_demo_results.json
