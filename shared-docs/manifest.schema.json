{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "manifest.schema.json",
  "title": "Pipeline manifest v1",
  "type": "object",
  "required": ["manifest", "pipeline", "version", "stages"],
  "properties": {
    "manifest": {"const": "pipeline-manifest/1"},
    "pipeline": {"type": "string", "pattern": "^[a-z0-9_-]+$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"},
    "pack": {"type": "string", "pattern": "^[a-z0-9_-]+$"},
    "evidence": {"$ref": "#/$defs/evidence"},
    "external_inputs": {"type": "array", "items": {"$ref": "#/$defs/kind"}, "uniqueItems": true},
    "items": {"$ref": "#/$defs/items"},
    "stages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/stage"}},
    "artifacts": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/kind"},
      "additionalProperties": {"$ref": "#/$defs/artifact"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "kind": {"type": "string", "pattern": "^[a-z0-9_-]+$"},
    "evidence": {
      "type": "object",
      "required": ["level", "kinds_allowed", "retention_days"],
      "properties": {
        "level": {"enum": ["E0", "E1", "E2"]},
        "kinds_allowed": {"type": "array", "items": {"$ref": "#/$defs/kind"}, "uniqueItems": true},
        "retention_days": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "items": {
      "type": "object",
      "required": ["roles"],
      "properties": {
        "roles": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "requires": {
      "type": "object",
      "required": ["stage", "item_role"],
      "properties": {
        "stage": {"type": "string", "pattern": "^[a-z0-9_-]+$"},
        "item_role": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "stage": {
      "type": "object",
      "required": ["name", "scope", "consumes", "produces"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z0-9_-]+$"},
        "scope": {"enum": ["item", "run"]},
        "requires": {"type": "array", "items": {"$ref": "#/$defs/requires"}},
        "consumes": {"type": "array", "items": {"$ref": "#/$defs/kind"}, "uniqueItems": true},
        "produces": {"type": "array", "items": {"$ref": "#/$defs/kind"}, "uniqueItems": true},
        "item_roles": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "consistency": {
      "type": "object",
      "required": ["id", "validator", "source", "fields"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "validator": {"type": "string", "minLength": 1},
        "source": {"$ref": "#/$defs/kind"},
        "fields": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "properties": {
        "schema": {"$ref": "https://json-schema.org/draft/2020-12/schema"},
        "consistency": {"type": "array", "items": {"$ref": "#/$defs/consistency"}}
      },
      "minProperties": 1,
      "additionalProperties": false
    }
  }
}
